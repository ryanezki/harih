# =============================================================================
# hariH VPS — salin file ini menjadi `.env` lalu isi semua nilainya.
# JANGAN pernah commit file `.env` (sudah masuk .gitignore).
# =============================================================================

# Subdomain n8n — buat DNS A record → IP VPS ini SEBELUM `docker compose up`
N8N_DOMAIN=n8n.harih.id

# Kunci enkripsi credentials n8n — generate: openssl rand -hex 24
# SIMPAN CADANGANNYA: kunci hilang = semua credentials n8n tidak terbaca lagi
N8N_ENCRYPTION_KEY=

# API key WAHA — generate: openssl rand -hex 24 (T1.7: tanpa ini WAHA terbuka)
WAHA_API_KEY=

# Engine WAHA: WEBJS (default, paling kompatibel, ~1 GB RAM) | NOWEB (ringan)
WAHA_ENGINE=WEBJS

# ---- Kredensial workflow (blueprint §3) — dibaca Code node via $env ----
WP_URL=https://harih.id
WP_APP_USER=n8nbot
WP_APP_PASSWORD=                # output scripts/setup-hostinger.sh langkah 3
WC_CK=                          # WooCommerce → Settings → Advanced → REST API
WC_CS=
WC_WEBHOOK_SECRET=              # samakan dengan secret saat membuat webhook WC (T1.19)
FORM_TOKEN_SECRET=              # HARUS SAMA dengan konstanta di wp-config.php (T1.3)
BREVO_API_KEY=
SHEET_ID=                       # ID Google Sheet operasional (T0.9)
