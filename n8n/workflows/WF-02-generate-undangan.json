        "jsCode": "// Satu item per file agar node HTTP upload berjalan per file (loop bawaan n8n).\n// Binary dioper sebagai referensi — aman untuk mode binary filesystem.\nconst wh = $('Webhook Form').first();\nconst d = $('Cek Order & Validasi').first().json;\nconst items = [];\n\nd.foto_keys.forEach((k, i) => {\n  const meta = wh.binary[k];\n  const ext = { 'image/png': 'png', 'image/webp': 'webp' }[String(meta.mimeType || '').toLowerCase()] || 'jpg';\n  items.push({\n    json: { jenis: 'foto', filename: `undangan-${d.order_id}-foto-${i + 1}.${ext}` },\n    binary: { data: meta },\n  });\n});\n\nif (d.ada_qris) {\n  items.push({\n    json: { jenis: 'qris', filename: `undangan-${d.order_id}-qris.png` },\n    binary: { data: wh.binary.qris },\n  });\n}\n\nreturn items;"
