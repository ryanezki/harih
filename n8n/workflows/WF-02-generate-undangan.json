    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d = $('Cek Order & Validasi').first().json;\nconst post = $('Buat Post Undangan').first().json;\nconst link = String(post.link || '');\nif (!link) throw new Error('Permalink undangan tidak ditemukan di respons WP');\n\nconst p1 = d.nama_pria.split(' ')[0];\nconst w1 = d.nama_wanita.split(' ')[0];\nconst paketLabel = d.paket.charAt(0).toUpperCase() + d.paket.slice(1);\nconst masaAktif = { hemat: 'sampai H+7', favorit: 'sampai H+30', premium: 'sampai 1 tahun setelah acara' }[d.paket];\nconst jatahRevisi = { hemat: '', favorit: '1×', premium: '3× + prioritas' }[d.paket];\nconst contoh = `${link}?to=Budi%20Santoso`;\n\n// Lampiran QR — bila node QR gagal (continueRegularOutput), kirim email tanpa lampiran\nlet qrB64 = '';\ntry {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  if (buf && buf.length > 100) qrB64 = buf.toString('base64');\n} catch (e) {\n  const item = $input.first();\n  const b = item.binary && item.binary.data && item.binary.data.data;\n  if (b && b.length > 100) qrB64 = b;\n}\n\n// WhatsApp — template 2b docs/copywriting-pesan.md (teks+link saja, T2.21)\nconst pesanWa = `🎉 Undanganmu sudah jadi, ${d.nama_depan}!\\n\\n*${p1} & ${w1}*\\n${link}\\n\\n📤 *Cara bagikan dengan nama tamu:*\\ntambahkan *?to=Nama%20Tamu* di belakang link\\n(ganti spasi dengan %20)\\n\\nContoh:\\n${contoh}\\n\\n📩 QR code + panduan lengkap sudah dikirim ke emailmu.\\n🗓️ Masa aktif: ${masaAktif}.\\n\\nSemoga lancar sampai hari H! 🤍\\n— hariH`;\n\n// Email — template 2a\nconst barisRevisi = jatahRevisi ? `<li>Revisi data: ${jatahRevisi} via CS.</li>` : '';\nconst barisQr = qrB64\n  ? '<p>Terlampir <strong>QR code</strong> undanganmu — cocok untuk dicetak di kartu fisik atau standee.</p>'\n  : '';\nconst html = `<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#333;line-height:1.6\">\n<p>Halo ${d.nama_depan},</p>\n<p>Selamat! Undangan digitalmu sudah tayang:</p>\n<p style=\"text-align:center;margin:24px 0\"><a href=\"${link}\" style=\"background:#5f6f56;color:#ffffff;padding:14px 28px;border-radius:6px;text-decoration:none;font-weight:bold\">BUKA UNDANGAN</a></p>\n<p style=\"font-size:13px;color:#666\"><a href=\"${link}\">${link}</a></p>\n<p><strong>Cara membagikan dengan nama tamu</strong> (nama muncul di halaman pembuka):<br>tambahkan <code>?to=Nama%20Tamu</code> di belakang link — ganti spasi dengan <code>%20</code>.</p>\n<p>Contoh: <a href=\"${contoh}\">${contoh}</a></p>\n${barisQr}\n<p><strong>Info paket ${paketLabel}:</strong></p>\n<ul>\n<li>Masa aktif halaman: ${masaAktif}.</li>\n${barisRevisi}\n</ul>\n<p>Semoga lancar sampai hari H! 🤍<br>Tim hariH · <a href=\"https://harih.id\">harih.id</a></p>\n</div>`;\n\nif (!$env.BREVO_SENDER_EMAIL) throw new Error('Env BREVO_SENDER_EMAIL belum di-set di container n8n');\nconst emailPayload = {\n  sender: { name: $env.BREVO_SENDER_NAME || 'hariH', email: $env.BREVO_SENDER_EMAIL },\n  to: [{ email: d.email, name: d.nama }],\n  subject: `🎉 Undangan ${p1} & ${w1} sudah jadi!`,\n  htmlContent: html,\n};\nif (qrB64) emailPayload.attachment = [{ name: 'qr-undangan.png', content: qrB64 }];\n\nreturn [{ json: { pesan_wa: pesanWa, email_payload: emailPayload, wa: d.wa, row_number: d.row_number, link, mempelai: `${p1} & ${w1}` } }];"
      },
