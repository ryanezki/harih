    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const wh = $('Webhook Form').first();\nconst body = wh.json.body || {};\nconst bin = wh.binary || {};\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.order_id !== undefined && String(r.order_id) !== '');\nconst row = rows[0] || null;\n\nconst out = (route, extra) => [{ json: Object.assign({ route }, extra || {}) }];\n\nif (!row) return out('tidak_ditemukan');\nconst status = String(row.status || '').toUpperCase();\nif (status === 'SUDAH_JADI') return out('sudah_jadi', { link_undangan: String(row.link_undangan || '') });\nif (status !== 'MENUNGGU_DATA') return out('diproses');\n\n// ---- T2.18: paket & template dari SHEET (asal: line item WC via WF-01) — BUKAN dari form/URL ----\nconst paket = ['hemat', 'favorit', 'premium'].includes(String(row.paket || '').toLowerCase())\n  ? String(row.paket).toLowerCase()\n  : 'hemat'; // fallback teraman — tidak ada upgrade gratis; pastikan nama produk WC memuat kata paket (T1.16)\nconst plus = paket !== 'hemat';\nconst premium = paket === 'premium';\n\n// Whitelist tema per paket (§10) — samakan dengan undangan_get_temas() di cpt.php.\n// Saat tema premium hadir, tambahkan hanya di daftar premium.\nconst TEMA_DASAR = ['tema-01', 'tema-02', 'tema-03'];\nconst TEMA_PAKET = { hemat: TEMA_DASAR, favorit: TEMA_DASAR, premium: TEMA_DASAR };\nconst temaDiminta = String(body.template_id || '').toLowerCase();\nconst template_id = (TEMA_PAKET[paket] || []).includes(temaDiminta) ? temaDiminta : 'tema-01';\n\n// ---- T2.19: validasi file server-side (validasi JS bisa dilewati via curl) ----\nconst MIME = ['image/jpeg', 'image/png', 'image/webp'];\nconst MAX_BYTES = 2 * 1024 * 1024;\nfunction keBytes(s) {\n  const m = /^([\\d.]+)\\s*(b|kb|mb|gb)$/i.exec(String(s || '').trim());\n  if (!m) return 0; // metadata ukuran tidak terbaca → loloskan; WP & N8N_PAYLOAD_SIZE_MAX tetap membatasi\n  return parseFloat(m[1]) * { b: 1, kb: 1024, mb: 1048576, gb: 1073741824 }[m[2].toLowerCase()];\n}\nlet fotoKeys = Object.keys(bin)\n  .filter((k) => /^foto_\\d+$/.test(k))\n  .sort((a, b) => parseInt(a.slice(5), 10) - parseInt(b.slice(5), 10));\nconst masalah = [];\nif (fotoKeys.length > 10) masalah.push(`jumlah foto ${fotoKeys.length} melebihi 10`);\nfor (const k of fotoKeys.concat(bin.qris ? ['qris'] : [])) {\n  const f = bin[k] || {};\n  if (!MIME.includes(String(f.mimeType || '').toLowerCase())) masalah.push(`${k}: tipe ${f.mimeType || '?'} tidak diizinkan`);\n  if (keBytes(f.fileSize) > MAX_BYTES) masalah.push(`${k}: ${f.fileSize} melebihi 2 MB`);\n}\nif (masalah.length) return out('file_invalid', { pesan: 'File ditolak — ' + masalah.join('; ') });\n\n// Paket hemat tidak punya galeri/amplop: file & field kelas atas diabaikan (T2.18/T2.19)\nif (!plus) fotoKeys = [];\nconst adaQris = plus && !!bin.qris;\n\nconst t = (v, n) => String(v == null ? '' : v).trim().slice(0, n);\nconst data = {\n  route: 'ok',\n  order_id: String(row.order_id),\n  row_number: row.row_number,\n  paket,\n  template_id,\n  nama: String(row.nama || 'Kak'),\n  nama_depan: String(row.nama || 'Kak').split(' ')[0],\n  email: String(row.email || ''),\n  wa: String(row.wa || '').replace(/\\D/g, ''),\n  nama_pria: t(body.nama_pria, 100),\n  nama_wanita: t(body.nama_wanita, 100),\n  ortu_pria: t(body.ortu_pria, 150),\n  ortu_wanita: t(body.ortu_wanita, 150),\n  tanggal_akad: t(body.tanggal_akad, 10),\n  waktu_akad: t(body.waktu_akad, 5),\n  tanggal_resepsi: t(body.tanggal_resepsi, 10),\n  waktu_resepsi: t(body.waktu_resepsi, 5),\n  lokasi_nama: t(body.lokasi_nama, 150),\n  lokasi_alamat: t(body.lokasi_alamat, 300),\n  // Lokasi AKAD terpisah (akad & resepsi lazim beda tempat) — opsional\n  lokasi_akad_nama: t(body.lokasi_akad_nama, 150),\n  lokasi_akad_alamat: t(body.lokasi_akad_alamat, 300),\n  gmaps_akad_url: t(body.gmaps_akad_url, 300),\n  // Konvensi Indonesia (evaluasi 2026-08-06) — semuanya opsional\n  anak_ke_pria: t(body.anak_ke_pria, 20),\n  anak_ke_wanita: t(body.anak_ke_wanita, 20),\n  ig_pria: t(body.ig_pria, 40).replace(/^@/, ''),\n  ig_wanita: t(body.ig_wanita, 40).replace(/^@/, ''),\n  dresscode: t(body.dresscode, 120),\n  dresscode_warna: t(body.dresscode_warna, 60),\n  turut_mengundang: t(body.turut_mengundang, 1200),\n  alamat_kado: t(body.alamat_kado, 400),\n  rundown: t(body.rundown, 1200),\n  catatan_lokasi: t(body.catatan_lokasi, 400),\n  catatan_lokasi_akad: t(body.catatan_lokasi_akad, 400),\n  gmaps_url: t(body.gmaps_url, 300),\n  love_story: plus ? t(body.love_story, 2000) : '',\n  musik_url: t(body.musik_url, 300),\n  video_url: premium ? t(body.video_url, 300) : '',\n  rekening: plus ? t(body.rekening, 300) : '',\n  wa_cp: t(body.wa_cp, 20),\n  foto_keys: fotoKeys,\n  ada_qris: adaQris,\n  total_file: fotoKeys.length + (adaQris ? 1 : 0),\n  tgl_acara: t(body.tanggal_resepsi, 10),\n};\nif (!data.nama_pria || !data.nama_wanita || !data.tanggal_resepsi) {\n  return out('file_invalid', { pesan: 'Data wajib belum lengkap: nama kedua mempelai dan tanggal resepsi harus diisi.' });\n}\nreturn [{ json: data }];"
      },
