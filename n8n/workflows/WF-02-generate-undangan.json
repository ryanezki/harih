      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst body = $input.first().json.body || {};\nconst orderId = String(body.order || '').replace(/\\D/g, '');\nconst key = String(body.key || '');\n\n// Rumus identik page-isi-data.php & WF-01: substr(hmac_sha256(order_id, FORM_TOKEN_SECRET), 0, 16)\nlet valid = false;\nif (orderId && key && $env.FORM_TOKEN_SECRET) {\n  const expect = crypto.createHmac('sha256', $env.FORM_TOKEN_SECRET).update(orderId).digest('hex').slice(0, 16);\n  const a = Buffer.from(key);\n  const b = Buffer.from(expect);\n  valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nreturn [{ json: { valid, order_id: orderId } }];"
      },
