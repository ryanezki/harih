      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst d = $('Cek Order & Validasi').first().json;\n\n// Korelasi upload → jenis berdasarkan urutan item (n8n mempertahankan urutan)\nlet files = [];\nlet uploads = [];\ntry {\n  files = $('Pisahkan File').all().map((i) => i.json);\n  uploads = $('Upload Media (WP)').all().map((i) => i.json);\n} catch (e) { /* jalur tanpa file (mis. paket hemat) */ }\n\nconst galeri = [];\nlet qrisUrl = '';\nuploads.forEach((u, i) => {\n  if (!u || !u.source_url) return;\n  if ((files[i] || {}).jenis === 'qris') qrisUrl = u.source_url;\n  else galeri.push(u.source_url);\n});\n\nconst slugify = (s) => String(s).toLowerCase().normalize('NFKD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\nconst p1 = d.nama_pria.split(' ')[0];\nconst w1 = d.nama_wanita.split(' ')[0];\nconst slug = `${slugify(p1 + '-' + w1) || 'undangan'}-${crypto.randomBytes(2).toString('hex')}`;\n\nconst post_payload = {\n  title: `${p1} & ${w1}`,\n  slug,\n  status: 'publish',\n  meta: {\n    paket: d.paket,\n    template_id: d.template_id,\n    order_id: d.order_id,\n    nama_pria: d.nama_pria,\n    nama_wanita: d.nama_wanita,\n    ortu_pria: d.ortu_pria,\n    ortu_wanita: d.ortu_wanita,\n    tanggal_akad: d.tanggal_akad,\n    waktu_akad: d.waktu_akad,\n    tanggal_resepsi: d.tanggal_resepsi,\n    waktu_resepsi: d.waktu_resepsi,\n    lokasi_nama: d.lokasi_nama,\n    lokasi_alamat: d.lokasi_alamat,\n    lokasi_akad_nama: d.lokasi_akad_nama,\n    lokasi_akad_alamat: d.lokasi_akad_alamat,\n    gmaps_akad_url: d.gmaps_akad_url,\n    anak_ke_pria: d.anak_ke_pria,\n    anak_ke_wanita: d.anak_ke_wanita,\n    ig_pria: d.ig_pria,\n    ig_wanita: d.ig_wanita,\n    dresscode: d.dresscode,\n    dresscode_warna: d.dresscode_warna,\n    turut_mengundang: d.turut_mengundang,\n    alamat_kado: d.alamat_kado,\n    rundown: d.rundown,\n    catatan_lokasi: d.catatan_lokasi,\n    catatan_lokasi_akad: d.catatan_lokasi_akad,\n    gmaps_url: d.gmaps_url,\n    love_story: d.love_story,\n    galeri: JSON.stringify(galeri),\n    musik_url: d.musik_url,\n    video_url: d.video_url,\n    rekening: d.rekening,\n    qris_media_url: qrisUrl,\n    wa_cp: d.wa_cp,\n  },\n};\n\nreturn [{ json: { post_payload } }];"
      },
