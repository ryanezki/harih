      "notes": "Kontrak form: POST nama, wa + field honeypot `website` (harus kosong). R1 2026-08-09 — bank & nomor rekening dicabut dari kontrak (B2); halaman pendaftarnya ikut dihapus, penggantinya /mitra/ (M8) + portal login (M3)."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json;\nconst body = j.body || {};\nconst headers = j.headers || {};\n\n// Honeypot (T3.10): bot mengisi field tersembunyi `website` → pura-pura sukses, tidak diproses\nif (String(body.website || '').trim() !== '') return [{ json: { route: 'honeypot' } }];\n\n// Rate limit ringan per IP (T3.10): max 5 pendaftaran/jam/IP — endpoint publik tanpa ini = mesin cetak kupon\nconst ip = String(headers['x-forwarded-for'] || headers['x-real-ip'] || 'tanpa-ip').split(',')[0].trim();\nconst sd = $getWorkflowStaticData('global');\nconst now = Date.now();\nsd.ipLog = sd.ipLog || {};\nfor (const k of Object.keys(sd.ipLog)) {\n  sd.ipLog[k] = sd.ipLog[k].filter((t) => now - t < 3600000);\n  if (!sd.ipLog[k].length) delete sd.ipLog[k];\n}\nsd.ipLog[ip] = sd.ipLog[ip] || [];\nif (sd.ipLog[ip].length >= 5) return [{ json: { route: 'rate' } }];\nsd.ipLog[ip].push(now);\n\n// Fungsi normalisasi nomor bersama (T2.14) — identik WF-01\nfunction normalisasiWa(input) {\n  let d = String(input || '').replace(/\\D/g, '');\n  if (!d) return '';\n  if (d.startsWith('0')) d = '62' + d.slice(1);\n  else if (d.startsWith('620')) d = '62' + d.slice(3);\n  else if (d.startsWith('8')) d = '62' + d;\n  if (!d.startsWith('62') || d.length < 10 || d.length > 15) return '';\n  return d;\n}\n\nconst t = (v, n) => String(v == null ? '' : v).trim().slice(0, n);\nconst nama = t(body.nama, 100);\nconst wa = normalisasiWa(body.wa);\n// R1 (2026-08-09) — `bank` & `norek` BERHENTI DIKUMPULKAN. Di model grosir\n// arah uang selalu mitra → hariH (B2), jadi tidak pernah ada payout dan\n// tidak pernah ada alasan sah menyimpan rekening siapa pun. Field yang\n// terlanjur dikirim klien lama diabaikan begitu saja, tidak disimpan.\n\nif (!nama || !wa) {\n  return [{ json: { route: 'invalid', pesan: 'Lengkapi nama dan nomor WhatsApp yang valid.' } }];\n}\nreturn [{ json: { route: 'ok', nama, wa } }];"
      },
