    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst q = $input.first().json.query || {};\nconst kode = String(q.kode || '').toUpperCase().trim();\nconst key = String(q.key || '');\n\nlet valid = false;\nif (/^RES-[A-Z0-9]{4}$/.test(kode) && key && $env.FORM_TOKEN_SECRET) {\n  const expect = crypto.createHmac('sha256', $env.FORM_TOKEN_SECRET).update(kode).digest('hex').slice(0, 16);\n  const a = Buffer.from(key);\n  const b = Buffer.from(expect);\n  valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nreturn [{ json: { valid, kode } }];"
      },
      "id": "wf03-verif-approve",
