    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst d = $('Validasi Pendaftaran').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.kode);\n\n// Idempotency by nomor WA (T3.10): satu nomor = satu kode\nif (rows.some((r) => String(r.wa || '').replace(/\\D/g, '') === d.wa)) {\n  return [{ json: { route: 'sudah_ada' } }];\n}\n\n// Kode RES-XXXX unik — charset tanpa karakter ambigu (0/O, 1/I/L)\nconst ada = new Set(rows.map((r) => String(r.kode).toUpperCase()));\nconst HURUF = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';\nlet kode = '';\nfor (let p = 0; p < 20 && !kode; p++) {\n  let k = 'RES-';\n  const b = crypto.randomBytes(4);\n  for (let i = 0; i < 4; i++) k += HURUF[b[i] % HURUF.length];\n  if (!ada.has(k)) kode = k;\n}\nif (!kode) throw new Error('Gagal membuat kode reseller unik setelah 20 percobaan');\n\n// Link approval owner (T3.10) — HMAC dgn FORM_TOKEN_SECRET, verifikasi di webhook approve\nconst key = crypto.createHmac('sha256', $env.FORM_TOKEN_SECRET).update(kode).digest('hex').slice(0, 16);\nconst linkApprove = `https://${$env.N8N_HOST || 'n8n.harih.id'}/webhook/approve-reseller?kode=${kode}&key=${key}`;\n\nconst tglDaftar = new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Jakarta' }).slice(0, 16);\n\nlet ownerWa = String($env.OWNER_WA || '').replace(/\\D/g, '');\nif (ownerWa.startsWith('0')) ownerWa = '62' + ownerWa.slice(1);\nelse if (ownerWa.startsWith('8')) ownerWa = '62' + ownerWa;\n\nconst teksOwner = `🔔 *[hariH] Pendaftar reseller baru*\\nNama: ${d.nama}\\nWA: ${d.wa}\\nKode (setelah aktif): *${kode}*\\n\\nSetuju? Ketuk untuk AKTIFKAN (buat kupon + kirim welcome kit):\\n${linkApprove}\\n\\nUntuk menolak: abaikan pesan ini, lalu hapus/tandai barisnya di sheet resellers.`;\n\nconst emailOwner = {\n  sender: { name: $env.BREVO_SENDER_NAME || 'hariH', email: $env.BREVO_SENDER_EMAIL },\n  to: [{ email: $env.OWNER_EMAIL }],\n  subject: `[hariH] Approval reseller: ${d.nama} (${kode})`,\n  htmlContent: `<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#333;line-height:1.6\">\\n<p>Pendaftar reseller baru menunggu approval:</p>\\n<ul><li>Nama: <strong>${d.nama}</strong></li><li>WA: ${d.wa}</li><li>Kode (setelah aktif): <strong>${kode}</strong></li></ul>\\n<p style=\"text-align:center;margin:24px 0\"><a href=\"${linkApprove}\" style=\"background:#5f6f56;color:#ffffff;padding:14px 28px;border-radius:6px;text-decoration:none;font-weight:bold\">AKTIFKAN RESELLER</a></p>\\n<p style=\"font-size:13px;color:#666\">Menolak? Abaikan email ini, lalu hapus/tandai barisnya di sheet <code>resellers</code>.</p>\\n</div>`,\n};\n\nreturn [{ json: { route: 'ok', ...d, kode, tgl_daftar: tglDaftar, owner_wa: ownerWa, teks_owner: teksOwner, email_owner: emailOwner } }];"
      },
