      "id": "wf08-cek-webhook",
      "name": "Cek Webhook WC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -900,
        400
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpBasicAuth": {
          "id": "HARIHWCREST00001",
          "name": "WC REST hariH"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map((i) => i.json).filter((w) => w && w.id && w.delivery_url);\nconst target = rows.filter((w) => String(w.delivery_url).includes('/webhook/wc-order'));\n\nconst masalah = [];\nif (!target.length) {\n  masalah.push('Webhook ke n8n (delivery URL …/webhook/wc-order) TIDAK DITEMUKAN — order baru tidak terkirim ke pipeline sama sekali.');\n}\nfor (const w of target) {\n  if (String(w.status) !== 'active') masalah.push(`Webhook #${w.id} berstatus \"${w.status}\" (bukan active).`);\n}\n\nconst perluAlert = masalah.length > 0;\nconst waktu = new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', hour12: false });\nconst teks = `🚨 *[hariH] Webhook WC bermasalah* — ${waktu} WIB\\n\\n${masalah.join('\\n')}\\n\\nPerbaiki: wp-admin → WooCommerce → Settings → Advanced → Webhooks → buka webhook-nya → Status: Active → Save.\\n\\nSelama bermasalah, rekonsiliasi 15-menit tetap memproses order yang tertinggal — tidak ada order hilang, hanya tertunda.`;\n\nlet ownerWa = String($env.OWNER_WA || '').replace(/\\D/g, '');\nif (ownerWa.startsWith('0')) ownerWa = '62' + ownerWa.slice(1);\nelse if (ownerWa.startsWith('8')) ownerWa = '62' + ownerWa;\n\nconst emailPayload = {\n  sender: { name: $env.BREVO_SENDER_NAME || 'hariH', email: $env.BREVO_SENDER_EMAIL },\n  to: [{ email: $env.OWNER_EMAIL }],\n  subject: '🚨 [hariH] Webhook WooCommerce tidak aktif',\n  htmlContent: `<pre style=\"font-family:Arial,Helvetica,sans-serif;white-space:pre-wrap;font-size:14px;color:#333\">${teks.replace(/\\*/g, '')}</pre>`,\n};\n\nreturn [{ json: { perlu_alert: perluAlert, teks, owner_wa: ownerWa, email_payload: emailPayload } }];"
      },
