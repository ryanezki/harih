    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WP_URL }}/wp-json/wc/v3/webhooks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendQuery": true,
