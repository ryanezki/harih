      "id": "wf08-cron-15m",
      "name": "Tiap 15 Menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1120,
        -100
      ],
      "notes": "Jaring pengaman T3.12: menangkap order yang hilang karena webhook WC ter-disable senyap / n8n sempat mati."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WP_URL }}/wp-json/wc/v3/orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "any"
            },
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "orderby",
              "value": "date"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "after",
              "value": "={{ new Date(Date.now() - 7 * 86400000).toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "wf08-ambil-order",
      "name": "Ambil Order WC (7 Hari)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -900,
        -100
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpBasicAuth": {
          "id": "HARIHWCREST00001",
          "name": "WC REST hariH"
        }
      },
      "notes": "status=any lalu difilter di Code (dukungan multi-status param WC tidak konsisten). Jendela 7 hari cukup: siklus 15 menit."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Respons array dipecah n8n jadi banyak item → padatkan ke 1 item agar node\n// Sheets berikutnya berjalan sekali, bukan per order.\nconst semua = $input.all().map((i) => i.json).filter((o) => o && o.id);\nconst orders = semua\n  .filter((o) => ['processing', 'completed'].includes(String(o.status)))\n  .map((o) => ({ id: o.id, status: o.status, dibuat_gmt: String(o.date_paid_gmt || o.date_created_gmt || '') }));\nreturn [{ json: { orders_wc: orders, total_diambil: semua.length } }];"
      },
      "id": "wf08-kumpulkan",
      "name": "Kumpulkan Order WC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        -100
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "orders",
          "mode": "name"
        },
        "options": {}
      },
      "id": "wf08-baca-sheet",
      "name": "Baca Orders Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -460,
        -100
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "googleApi": {
          "id": "GOOGLESAHARIH001",
          "name": "Google SA hariH"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst kumpul = $('Kumpulkan Order WC').first().json;\nconst sheetIds = new Set(\n  $input.all().map((i) => i.json)\n    .filter((r) => r && r.order_id !== undefined && String(r.order_id) !== '')\n    .map((r) => String(r.order_id))\n);\n\nconst now = Date.now();\nconst tertinggal = kumpul.orders_wc.filter((o) => {\n  if (sheetIds.has(String(o.id))) return false;\n  // Beri jeda 10 menit: delivery webhook yang normal mungkin masih dalam perjalanan\n  const t = Date.parse(o.dibuat_gmt ? o.dibuat_gmt + 'Z' : '');\n  return isFinite(t) ? now - t > 10 * 60 * 1000 : true;\n});\n\nif (!tertinggal.length) return []; // tidak ada yang tertinggal → cabang ini selesai\n\nif (!$env.WC_WEBHOOK_SECRET) throw new Error('Env WC_WEBHOOK_SECRET belum di-set di container n8n');\n\n// Kirim ulang ke WF-01 via loopback dengan payload + signature persis seperti\n// webhook WC asli — logika intake tidak diduplikasi, idempotency tetap satu pintu.\nreturn tertinggal.map((o) => {\n  const raw = JSON.stringify({ action: 'woocommerce_order_status_processing', arg: o.id });\n  const sig = crypto.createHmac('sha256', $env.WC_WEBHOOK_SECRET).update(raw).digest('base64');\n  return { json: { order_id: o.id, raw_body: raw, signature: sig, truncated: kumpul.total_diambil >= 100 } };\n});"
      },
      "id": "wf08-cari-tertinggal",
      "name": "Cari Order Tertinggal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/wc-order",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-wc-webhook-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.raw_body }}",
        "options": {}
      },
      "id": "wf08-loopback",
      "name": "Kirim Ulang ke WF-01",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "Loopback ke webhook produksi WF-01 (harus Active). Body raw + signature valid → lolos verifikasi HMAC WF-01."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tertinggal = $('Cari Order Tertinggal').all().map((i) => i.json);\nconst hasil = $input.all().map((i) => i.json);\n\nconst gagal = [];\nhasil.forEach((h, i) => {\n  if (h && h.error) gagal.push(tertinggal[i] ? tertinggal[i].order_id : '?');\n});\n\nconst ids = tertinggal.map((m) => '#' + m.order_id).join(', ');\nconst waktu = new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', hour12: false });\n\nlet teks = `⚠️ *[hariH] Rekonsiliasi order* — ${waktu} WIB\\n\\n${tertinggal.length} order TERTINGGAL (ada di WooCommerce, tidak ada di sheet) dan sudah dikirim ulang ke WF-01: ${ids}\\n\\nIni pertanda pipeline webhook sempat gagal — cek WooCommerce → Settings → Advanced → Webhooks (status & riwayat delivery) dan riwayat eksekusi n8n.`;\nif (gagal.length) teks += `\\n\\n🚨 Gagal diproses ulang: #${gagal.join(', #')} — tangani manual (lihat runbook).`;\nif (tertinggal.some((m) => m.truncated)) teks += `\\n\\nℹ️ Pengambilan order WC menyentuh batas 100 — bila masih ada yang tertinggal, tertangkap di siklus 15 menit berikutnya.`;\n\nlet ownerWa = String($env.OWNER_WA || '').replace(/\\D/g, '');\nif (ownerWa.startsWith('0')) ownerWa = '62' + ownerWa.slice(1);\nelse if (ownerWa.startsWith('8')) ownerWa = '62' + ownerWa;\n\nconst emailPayload = {\n  sender: { name: $env.BREVO_SENDER_NAME || 'hariH', email: $env.BREVO_SENDER_EMAIL },\n  to: [{ email: $env.OWNER_EMAIL }],\n  subject: `⚠️ [hariH] Rekonsiliasi: ${tertinggal.length} order tertinggal diproses ulang`,\n  htmlContent: `<pre style=\"font-family:Arial,Helvetica,sans-serif;white-space:pre-wrap;font-size:14px;color:#333\">${teks.replace(/\\*/g, '')}</pre>`,\n};\n\nreturn [{ json: { teks, owner_wa: ownerWa, email_payload: emailPayload } }];"
      },
      "id": "wf08-susun-alert",
      "name": "Susun Alert Rekonsiliasi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        -100
      ],
      "notes": "Rekonsiliasi yang MENEMUKAN sesuatu = insiden — owner selalu diberi tahu; nihil temuan = senyap."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WAHA_URL }}/api/sendText",
