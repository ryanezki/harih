      "id": "wf01-webhook",
      "name": "Webhook WC Order",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1540,
        0
      ],
      "webhookId": "harih-wc-order",
      "notes": "Respond Immediately (T2.13): WC menghitung respons lambat sebagai delivery gagal. Raw Body wajib untuk verifikasi HMAC."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst sig = headers['x-wc-webhook-signature'] || '';\n\n// Raw body ada di binary `data`; getBinaryDataBuffer aman utk mode binary filesystem\nlet raw;\ntry {\n  raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n} catch (e) {\n  const b64 = item.binary && item.binary.data && item.binary.data.data;\n  if (!b64) throw new Error('Raw body tidak ditemukan — pastikan opsi Raw Body aktif di node Webhook');\n  raw = Buffer.from(b64, 'base64');\n}\nconst text = raw.toString('utf8');\n\n// Ping WC saat webhook disimpan: body form-encoded `webhook_id=..` tanpa signature valid (T2.11)\nif (/^webhook_id=\\d+/.test(text.trim())) {\n  return [{ json: { ping: true, order_id: 0 } }];\n}\n\nif (!$env.WC_WEBHOOK_SECRET) throw new Error('Env WC_WEBHOOK_SECRET belum di-set di container n8n');\nconst expect = crypto.createHmac('sha256', $env.WC_WEBHOOK_SECRET).update(raw).digest('base64');\nconst a = Buffer.from(String(sig));\nconst b = Buffer.from(expect);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  throw new Error(`Signature webhook WC tidak valid (delivery: ${headers['x-wc-webhook-delivery-id'] || '-'}) — cek WC_WEBHOOK_SECRET sama di WooCommerce & env n8n`);\n}\n\nconst body = JSON.parse(text);\n// Topic Action (T1.19): body = { action, arg: order_id }. Fallback body.id bila topic Order dipakai.\nconst orderId = Number(body.arg || body.id || 0);\nif (!orderId) throw new Error('order_id tidak ditemukan di payload webhook WC');\nreturn [{ json: { ping: false, order_id: orderId } }];"
      },
