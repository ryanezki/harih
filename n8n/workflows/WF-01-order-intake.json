      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Append-then-verify (T2.12): lanjut HANYA bila baris kita adalah yang pertama utk order_id ini.\n// Lookup->append tidak atomik; dua delivery paralel bisa sama-sama lolos lookup.\nconst d = $('Siapkan Data Order').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => String(r.order_id) === String(d.order_id));\n\nif (!rows.length) {\n  throw new Error(`Verifikasi idempotency gagal: baris order ${d.order_id} tidak terbaca kembali dari sheet`);\n}\n\nrows.sort((a, b) => (a.row_number || 0) - (b.row_number || 0));\nconst milikku = rows.find((r) => String(r.exec_id || '') === d.exec_id);\nif (!milikku) {\n  throw new Error(`Verifikasi idempotency gagal: exec_id ${d.exec_id} tidak ditemukan — pastikan header kolom 'wa_status' dan 'exec_id' ada di tab orders`);\n}\n\nconst duplikat = String(rows[0].exec_id || '') !== d.exec_id;\nreturn [{ json: { ...d, duplikat, row_number: milikku.row_number, hapus_row: duplikat ? milikku.row_number : 0 } }];"
      },
