        "jsCode": "const d = $('Cek Duplikat').first().json;\nconst paketLabel = d.paket ? d.paket.charAt(0).toUpperCase() + d.paket.slice(1) : 'Undangan Digital';\n\n// WhatsApp — template 1b docs/copywriting-pesan.md\nconst pesanWa = `Halo ${d.nama_depan}! 🤍\\n\\nPembayaran pesanan *#${d.order_id}* (paket *${paketLabel}*) sudah kami terima. Terima kasih!\\n\\nTinggal satu langkah lagi — isi data undanganmu di sini (±10 menit):\\n${d.link_form}\\n\\n⏱️ Setelah data dikirim, undangan jadi otomatis dalam ±5 menit.\\n🔒 Link ini pribadi, jangan dibagikan ya.\\n\\nAda pertanyaan? Balas saja pesan ini.\\n— hariH`;\n\n// Email — template 1a\nconst html = `<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#333;line-height:1.6\">\n<p>Halo ${d.nama_depan},</p>\n<p>Terima kasih! Pembayaran untuk pesanan <strong>#${d.order_id}</strong> (paket <strong>${paketLabel}</strong>) sudah kami terima.</p>\n<p>Tinggal satu langkah lagi: isi data undanganmu (±10 menit) lewat tombol di bawah. Setelah dikirim, undangan langsung jadi otomatis dalam ±5 menit dan dikirim ke email &amp; WhatsApp-mu.</p>\n<p style=\"text-align:center;margin:28px 0\"><a href=\"${d.link_form}\" style=\"background:#5f6f56;color:#ffffff;padding:14px 28px;border-radius:6px;text-decoration:none;font-weight:bold\">ISI DATA UNDANGAN</a></p>\n<p style=\"font-size:13px;color:#666\">Tombol tidak berfungsi? Salin link ini:<br><a href=\"${d.link_form}\">${d.link_form}</a></p>\n<p><strong>Catatan penting:</strong></p>\n<ul>\n<li>Link ini <strong>pribadi</strong> — jangan dibagikan ke siapa pun.</li>\n<li>Siapkan: nama kedua mempelai &amp; orang tua, tanggal/lokasi acara, dan (sesuai paket) foto-foto terbaikmu.</li>\n</ul>\n<p>Butuh bantuan? Balas email ini atau hubungi CS kami.</p>\n<p>Salam hangat,<br>Tim hariH · <a href=\"https://harih.id\">harih.id</a></p>\n</div>`;\n\nif (!$env.BREVO_SENDER_EMAIL) throw new Error('Env BREVO_SENDER_EMAIL belum di-set di container n8n');\nconst emailPayload = {\n  sender: { name: $env.BREVO_SENDER_NAME || 'hariH', email: $env.BREVO_SENDER_EMAIL },\n  to: [{ email: d.email, name: d.nama }],\n  subject: `Pesanan #${d.order_id} diterima — yuk isi data undanganmu ✨`,\n  htmlContent: html,\n};\n\nreturn [{ json: { ...d, pesan_wa: pesanWa, email_payload: emailPayload } }];"
      },
