    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst o = $input.first().json;\n\n// Fungsi normalisasi nomor bersama (T2.14) — jaga identik dengan WF-02/WF-03\nfunction normalisasiWa(input) {\n  let d = String(input || '').replace(/\\D/g, '');\n  if (!d) return '';\n  if (d.startsWith('0')) d = '62' + d.slice(1);\n  else if (d.startsWith('620')) d = '62' + d.slice(3);\n  else if (d.startsWith('8')) d = '62' + d;\n  if (!d.startsWith('62') || d.length < 10 || d.length > 15) return '';\n  return d;\n}\n\nconst billing = o.billing || {};\nconst nama = [billing.first_name, billing.last_name].filter(Boolean).join(' ').trim() || 'Kak';\nconst namaDepan = billing.first_name || nama;\nconst email = billing.email || '';\nconst wa = normalisasiWa(billing.phone);\n\nconst items = Array.isArray(o.line_items) ? o.line_items : [];\nconst namaItem = (items[0] && items[0].name ? items[0].name : '').toLowerCase();\nconst paket = ['hemat', 'favorit', 'premium'].find((p) => namaItem.includes(p)) || '';\n\n// T2.15: dasar komisi = jumlah line item SETELAH diskon kupon (li.total),\n// BUKAN o.total yang bisa memuat fee kanal pembayaran\nconst dasarKomisi = items.reduce((s, li) => s + (parseFloat(li.total) || 0), 0);\n\nconst kupon = ((o.coupon_lines && o.coupon_lines[0] && o.coupon_lines[0].code) || '').toUpperCase();\n\n// Token HARUS identik dgn page-isi-data.php: substr(hash_hmac('sha256', order_id, FORM_TOKEN_SECRET), 0, 16)\nif (!$env.FORM_TOKEN_SECRET) throw new Error('Env FORM_TOKEN_SECRET belum di-set di container n8n');\nconst token = crypto.createHmac('sha256', $env.FORM_TOKEN_SECRET).update(String(o.id)).digest('hex').slice(0, 16);\nconst linkForm = `${$env.WP_URL}/isi-data/?order=${o.id}&key=${token}${paket ? `&paket=${paket}` : ''}`;\n\nconst tglOrder = String(o.date_paid || o.date_created || '').replace('T', ' ').slice(0, 16);\n\nreturn [{ json: {\n  order_id: String(o.id),\n  tgl_order: tglOrder,\n  nama,\n  nama_depan: namaDepan,\n  email,\n  wa,\n  paket,\n  kupon,\n  total: String(o.total),\n  token,\n  link_form: linkForm,\n  dasar_komisi: dasarKomisi,\n  komisi: Math.round(dasarKomisi * 0.3),\n  exec_id: String($execution.id),\n} }];"
      },
